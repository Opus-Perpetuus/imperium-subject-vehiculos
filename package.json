{
  "name": "subject-vehiculos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch run src/server.ts",
    "test": "SUBJECT_AUTH=off KIRLET_AUTH=off bun test --max-concurrency 1",
    "manifest:emit": "bun run scripts/emit-manifest.ts",
    "docker:build": "docker build --build-context kit=../../kit -t ghcr.io/opus-perpetuus/subject-vehiculos:0.1.0 -t ghcr.io/opus-perpetuus/subject-vehiculos:latest ."
  },
  "dependencies": {
    "@opus-perpetuus/imperium-core-kit": "file:./vendor/kit",
    "@opus-perpetuus/kirel-nox-kit": "file:./vendor/kit"
  },
  "devDependencies": {
    "@types/bun": "^1.2.8"
  }
}
